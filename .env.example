CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_PROFILE=dpeek
# Bootstrap an owner in a fresh database.
OWNER_EMAIL=
OWNER_PASSWORD=
# Generate the bootstrap password and each signing key separately from
# 32 random bytes encoded as base64url.
AUTH_SECRET=
MCP_OAUTH_SECRET=
# Generate once with bun run push:keys; keep this pair stable across deploys.
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
# A contact URI for browser push services, e.g. mailto:mail@dpeek.com.
# PUSH_SUBJECT=
# Set on the stage that owns the custom hostname.
# APP_DOMAIN=app.dpeek.com
# Cloudflare DNS zone ID for APP_DOMAIN. In production, this is the dpeek.com
# zone and also enables outbound mailbox mail from mail@dpeek.com.
# ACCOUNT_EMAIL_ZONE_ID=
# Local read-only iCloud inventory/export (never deployed as Worker bindings).
# Use the underlying iCloud IMAP login and an Apple app-specific password.
# ICLOUD_IMAP_USER=your-login@icloud.com
# ICLOUD_IMAP_PASSWORD=

# Additional inbound addresses to bootstrap into Personal. Existing rules in
# Settings → Mail keep their destination and receiving status.
# MAILBOX_ALIASES=david@winterpeek.com
