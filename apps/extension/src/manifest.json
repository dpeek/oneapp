{
  "manifest_version": 3,
  "name": "OneApp",
  "version": "0.0.0",
  "description": "Save the current tab to OneApp.",
  "key": "",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://app.dpeek.com/*"],
  "externally_connectable": { "matches": ["https://app.dpeek.com/*"] },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html"
  }
}
