{
  "manifest_version": 3,
  "name": "Orumai",
  "version": "0.0.0",
  "description": "Save the current tab to Orumai.",
  "key": "",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://app.dpeek.com/*"],
  "externally_connectable": { "matches": ["https://app.dpeek.com/*"] },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/orumai-16.png",
    "32": "icons/orumai-32.png",
    "48": "icons/orumai-48.png",
    "128": "icons/orumai-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/orumai-16.png",
      "32": "icons/orumai-32.png"
    },
    "default_popup": "popup.html"
  }
}
