{
  "name": "orumai",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:pull": "bun scripts/dev-pull.ts",
    "apple:build": "sh apps/apple/build.sh",
    "apple:dev": "bun run apple:build && open apps/apple/dist/Orumai.app",
    "build": "bun run --parallel --filter './apps/*' build",
    "deploy": "bun scripts/deploy.ts",
    "db:generate": "bun --bun drizzle-kit generate --config apps/web/drizzle.config.ts",
    "push:keys": "bun apps/web/push-keys.ts",
    "mail:inventory": "bun scripts/mail-inventory.ts",
    "mail:dev": "bun scripts/dev.ts --stage mail_sample",
    "mail:sample": "bun scripts/mail-sample.ts",
    "mail:export": "bun scripts/mail-export.ts",
    "mail:import": "bun scripts/mail-import.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "verify": "bun fmt && bun check && bun run test",
    "backup:capture": "bun scripts/backup.ts capture",
    "backup:restore": "bun scripts/backup.ts restore"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.85",
    "@alchemy.run/sql": "2.0.0-beta.85",
    "@cloudflare/workers-auth": "0.18.1",
    "@effect/platform-bun": "~4.1.0",
    "@effect/platform-node": "~4.1.0",
    "@effect/vitest": "~4.1.0",
    "@types/bun": "1.4.4",
    "alchemy": "2.0.0-beta.85",
    "drizzle-kit": "1.0.0-rc.5",
    "effect": "~4.1.0",
    "imapflow": "^2.12.2",
    "vitest": "^5.1.0"
  }
}
